CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_TUYA_T5AI_BOARD=y
CONFIG_TUYA_T5AI_BOARD_LCD_35565=y
CONFIG_ENABLE_LIBLVGL=y
CONFIG_ENABLE_LVGL_TP=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_ENABLE_AI_PLAYER=y
# Development-only serial commands.  This exposes sys_netmgr/kv_set on UART0
# so a flashed board can be moved between Wi-Fi networks without committing
# credentials or rebuilding firmware for every location.
CONFIG_ENABLE_SERIAL_CLI_CMD=y
