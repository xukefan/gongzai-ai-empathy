# Development: SQLite. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/gongzai
DATABASE_URL=sqlite:///./coglink.db
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
# Required in production: generate a long random value and keep it private.
AUTH_SECRET_KEY=dev-only-change-this
# 7 days; valid range is 5 minutes to 30 days.
AUTH_TOKEN_TTL_SECONDS=604800

# Use the exact function codes defined in the Tuya product schema.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_ENDPOINT=https://openapi.tuyacn.com
TUYA_BPM_CODE=bpm
TUYA_PATTERN_CODE=pattern
TUYA_TRIGGER_CODE=trigger
# direct is the current main path: T5AI polls FastAPI over Wi-Fi.
# Set to tuya only when the device is linked to a usable Tuya cloud project.
PENDANT_DELIVERY_MODE=direct
# Shared prototype token sent by the pendant as X-Pendant-Token.
PENDANT_API_TOKEN=
# Separate signing secret for short-lived pendant audio URLs. Never reuse the
# polling token and never put either secret in a URL or repository.
PENDANT_PLAYBACK_TICKET_SECRET=
# 30--3600 seconds; 300 is suitable for a short competition-demo playback.
PENDANT_PLAYBACK_TICKET_TTL_SECONDS=300
# Set this behind a reverse proxy so generated pendant audio URLs use the
# public HTTPS origin, for example: https://api.example.com
PUBLIC_API_BASE_URL=

# Comma-separated origins in production, for example: https://app.example.com
CORS_ORIGINS=*
VOICE_STORAGE_DIR=uploads/voices
# The source recording stays above for ASR/diary. ffmpeg writes a distinct
# mono 16 kHz MP3 here for the pendant.
PENDANT_AUDIO_DIR=uploads/pendant_audio
FFMPEG_BINARY=ffmpeg
PENDANT_AUDIO_SAMPLE_RATE=16000
PENDANT_AUDIO_BITRATE=32k
PENDANT_AUDIO_TRANSCODE_TIMEOUT_SECONDS=30
MAX_VOICE_UPLOAD_BYTES=20971520

# Internal ASR service. Keep real values only in the server's private .env.
ASR_INTERNAL_API_KEY=
ASR_MAX_AUDIO_BYTES=524288000
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_LANGUAGE=autodialect

# OpenAI-compatible endpoint used only by the server to create diary entries.
# Leave AI_API_KEY empty to use a clearly marked fallback while developing.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
# Retry transient model-provider failures before preserving an original-text
# fallback diary. Values are capped in config.py to keep requests bounded.
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY_SECONDS=0.8
