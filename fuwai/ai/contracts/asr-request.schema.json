{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gongzai-ai.local/schemas/asr-request.schema.json",
  "title": "ASR Request Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "source", "consent"],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "生活瞬间或回复对应的唯一事件 ID"
    },
    "source": {
      "type": "string",
      "enum": ["watch", "pendant"],
      "description": "录音来源"
    },
    "language": {
      "type": "string",
      "const": "zh-CN",
      "description": "第一阶段只支持中文普通话"
    },
    "consent": {
      "type": "boolean",
      "const": true,
      "description": "用户必须主动授权转写"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
