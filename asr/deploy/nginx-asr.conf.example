# 把 example.com、证书路径和服务 IP 替换为部署环境的真实值。
# Uvicorn 只监听本机，HTTPS 由 Nginx 在此处终止。
server {
    listen 443 ssl http2;
    server_name asr.example.com;

    ssl_certificate     /etc/letsencrypt/live/asr.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/asr.example.com/privkey.pem;
    client_max_body_size 500m;

    location = /internal/ai/asr {
        # 生产环境需在此处限制来源，例如仅允许成员 2 的服务网段或 API 网关。
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8001;
    }
}
