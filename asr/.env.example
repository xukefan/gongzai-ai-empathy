# 从讯飞开放平台：控制台 -> 我的应用 -> 应用详情 -> 认证信息 获取
IFLYTEK_APP_ID=填写你的APPID
IFLYTEK_API_KEY=填写你的APIKey
IFLYTEK_API_SECRET=填写你的APISecret

# 录音文件转写大模型固定服务地址（官方文档）
IFLYTEK_BASE_URL=https://office-api-ist-dx.iflyaisol.com

# 音频统一为 16kHz
IFLYTEK_LANGUAGE=autodialect
ASR_SAMPLE_RATE=16000

# 成员 2 调用本服务时放在 X-API-Key 请求头中的内部共享密钥。
# 由部署负责人生成并通过私密渠道交给成员 2，不是讯飞 APIKey。
ASR_INTERNAL_API_KEY=填写随机的内部调用密钥
ASR_MAX_AUDIO_BYTES=524288000
