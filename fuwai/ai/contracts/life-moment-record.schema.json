{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gongzai-ai.local/schemas/life-moment-record.schema.json",
  "title": "Complete Life Moment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "event_id", "user_id", "title", "summary", "raw_text",
    "raw_transcript", "confirmed_transcript", "voice_id", "source", "bpm",
    "recorded_at", "tags", "suggested_replies", "safety_flags", "ai_status",
    "prompt_version", "schema_version", "image_urls", "user_note", "shared_at",
    "acknowledged_at", "reply_voice_id", "reply_raw_transcript",
    "reply_confirmed_transcript", "replied_at", "status", "created_at"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "event_id": {"type": ["string", "null"], "maxLength": 128},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": ["string", "null"], "maxLength": 100},
    "summary": {"type": ["string", "null"], "maxLength": 2000},
    "raw_text": {"type": ["string", "null"]},
    "raw_transcript": {"type": ["string", "null"]},
    "confirmed_transcript": {"type": ["string", "null"]},
    "voice_id": {"type": ["string", "null"], "maxLength": 128},
    "source": {"type": ["string", "null"], "enum": ["watch", "iphone", "pendant", null]},
    "bpm": {"type": ["integer", "null"], "minimum": 30, "maximum": 240},
    "recorded_at": {"type": ["string", "null"], "format": "date-time"},
    "tags": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 20}},
    "suggested_replies": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 200}},
    "safety_flags": {"type": "array", "items": {"type": "string"}},
    "ai_status": {"type": ["string", "null"], "enum": ["generated", "fallback", "failed", null]},
    "prompt_version": {"type": ["string", "null"], "maxLength": 64},
    "schema_version": {"type": "integer", "const": 1},
    "image_urls": {"type": "array", "maxItems": 9, "items": {"type": "string", "maxLength": 2000}},
    "user_note": {"type": ["string", "null"], "maxLength": 2000},
    "shared_at": {"type": ["string", "null"], "format": "date-time"},
    "acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
    "reply_voice_id": {"type": ["string", "null"], "maxLength": 128},
    "reply_raw_transcript": {"type": ["string", "null"]},
    "reply_confirmed_transcript": {"type": ["string", "null"]},
    "replied_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": ["string", "null"], "enum": ["active", "shared", "responded", "archived", null]},
    "created_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
