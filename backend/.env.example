# Development: SQLite. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/gongzai
DATABASE_URL=sqlite:///./coglink.db
HOST=0.0.0.0
PORT=8000

# Use the exact function codes defined in the Tuya product schema.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_ENDPOINT=https://openapi.tuyacn.com
TUYA_BPM_CODE=bpm
TUYA_PATTERN_CODE=pattern
TUYA_TRIGGER_CODE=trigger

# Comma-separated origins in production, for example: https://app.example.com
CORS_ORIGINS=*
VOICE_STORAGE_DIR=uploads/voices
MAX_VOICE_UPLOAD_BYTES=20971520
